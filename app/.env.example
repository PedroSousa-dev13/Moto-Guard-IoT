# MotoGuard IoT — Configuração de Ambiente
# Copiar para .env e ajustar valores
# =============================================================================

# Base de Dados PostgreSQL
DATABASE_URL="postgresql://motoguard:motoguard123@localhost:5432/motoguard?schema=public"

# JWT Secret
JWT_SECRET="motoguard-secret-key-2026"

# MQTT Broker
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_USER="backend"
MQTT_PASS="backend123"
MQTT_TOPIC_TELEMETRIA="motoguard/telemetria"
MQTT_TOPIC_COMANDO="motoguard/comando"

# InfluxDB
INFLUXDB_URL="http://localhost:8086"
INFLUXDB_TOKEN="motoguard-token"
INFLUXDB_ORG="motoguard"
INFLUXDB_BUCKET="telemetry"

# Servidor
PORT=3000
NODE_ENV="development"

# ML Pipeline
ML_ENABLED=false
ML_MODEL_PATH="ml/models/isolation_forest.pkl"

# Email de Emergência (Resend) — opcional
# Criar conta gratuita em https://resend.com e gerar uma API key
# Se RESEND_API_KEY estiver vazio, os emails são apenas registados no log (modo dev)
RESEND_API_KEY=""
RESEND_FROM="onboarding@resend.dev"
APP_URL="http://localhost:3000"
