{
  "name": "motoguard-backend",
  "version": "1.0.0",
  "description": "MotoGuard IoT - Backend API",
  "main": "backend/dist/index.js",
  "scripts": {
    "build": "cd backend && npx tsc",
    "start": "node backend/dist/index.js",
    "dev": "npx tsx backend/src/index.ts",
    "dev:watch": "npx tsx watch backend/src/index.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:studio": "npx prisma studio",
    "prisma:deploy": "npx prisma migrate deploy",
    "prisma:seed": "npx tsx prisma/seed.ts",
    "db:view": "npx tsx scripts/view-database.ts",
    "db:trips": "npx tsx scripts/view-database.ts trips",
    "db:events": "npx tsx scripts/view-database.ts events",
    "db:motas": "npx tsx scripts/view-database.ts motorcycles",
    "db:users": "npx tsx scripts/view-database.ts users"
  },
  "dependencies": {
    "@influxdata/influxdb-client": "^1.35.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "fast-xml-parser": "^5.2.5",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mqtt": "^5.10.0",
    "pg": "^8.20.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "prisma": "^7.4.2",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "hono": "^4.12.7",
    "@hono/node-server": "^1.19.10"
  }
}
